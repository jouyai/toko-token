# ===== Salin ke .env lalu isi. JANGAN commit file .env. =====

# --- Domain & aplikasi ---
DOMAIN=tokotoken.id
APP_URL=https://tokotoken.id
APP_NAME=Toko Token

# --- Database (dipakai docker-compose) ---
POSTGRES_PASSWORD=ganti-dengan-password-acak-panjang

# --- 9router ---
# Password pertama untuk login dashboard 9router.
ROUTER_DASHBOARD_PASSWORD=ganti-password-dashboard-9router
# API key yang kamu buat di dashboard 9router (menu API Keys).
ROUTER_API_KEY=
# Kalau 9router jalan di server lain (bukan lewat docker-compose ini), isi alamatnya:
# ROUTER_BASE_URL=https://router.domainkamu.id/v1

# --- Midtrans (https://dashboard.midtrans.com → Settings → Access Keys) ---
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
# false = sandbox (untuk tes), true = production (uang beneran)
MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_ENABLED_PAYMENTS=other_qris,gopay,shopeepay,bca_va,bni_va,bri_va,permata_va,other_va

# --- Email (wajib, untuk reset password). Contoh: Brevo, Mailgun, Gmail SMTP ---
SMTP_URL=smtps://user:password@smtp.contoh.com:465
MAIL_FROM=Toko Token <no-reply@tokotoken.id>

# --- Kontak support (tampil di halaman /kontak) ---
SUPPORT_EMAIL=halo@tokotoken.id
SUPPORT_WHATSAPP=6281234567890

# --- Aturan top up & pemakaian (opsional) ---
# MIN_TOPUP_RP=10000
# MAX_TOPUP_RP=5000000
# TOPUP_PRESETS_RP=10000,25000,50000,100000,250000,500000
# API_RPM_PER_KEY=60
# MAX_CONCURRENT_PER_USER=4
# DEFAULT_MAX_OUTPUT_TOKENS=8192
# ID_SECRET=  # opsional: kunci penyamar id tool call (default turunan ROUTER_API_KEY)
